<%- include('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>

    <p>Here are our service project categories:</p>

    <div class="categories-container">
      <% categories.forEach(category=> { %>
        <div class="category-card">
          <div class="category-name">
            <%= category.name %>
          </div>
        </div>
        <% }); %>
    </div>
  </main>

  <%- include('partials/footer') %>