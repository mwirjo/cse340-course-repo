<%- include('partials/header') %>
    <main>
        <!-- Display the category name as the page heading -->
        <h1>
            <%= title %>
        </h1>

        <!-- List all service projects for this category -->
        <h2>Service Projects</h2>

        <div class="projects-container">
            <% projects.forEach(project=> { %>
                <!-- Each project card uses organization ID for color coding -->
                <div class="project-card project-org-<%= project.organization_id %>">

                    <!-- Project title links to the project details page -->
                    <p class="project-title">
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </p>

                    <!-- Organization name links to the organization details page -->
                    <p class="project-org">
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <!-- Project description -->
                    <p class="project-description">
                        <%= project.description %>
                    </p>

                    <!-- Project location -->
                    <p class="project-location">📍 <%= project.location %>
                    </p>

                    <!-- Project date -->
                    <p class="project-date">📅 <%= project.date %>
                    </p>

                </div>
                <% }) %>
        </div>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-category/<%= category.category_id %>" class="org-add-link">Edit Category</a>
            <% } %>
    </main>
    <%- include('partials/footer') %>