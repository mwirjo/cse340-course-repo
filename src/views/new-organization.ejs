<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <div class="form-card">
            <form action="/new-organization" method="POST">
                <div class="form-group">
                    <label for="name">Organization Name</label>
                    <input type="text" id="name" name="name" placeholder="e.g. Green Future Foundation" maxlength="150"
                        required />
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" placeholder="What does this organization do?"
                        maxlength="500" required></textarea>
                </div>
                <div class="form-group">
                    <label for="contactEmail">Contact Email</label>
                    <input type="email" id="contactEmail" name="contactEmail" placeholder="e.g. contact@example.org"
                        required />
                </div>
                <button type="submit" class="form-submit-btn">Create Organization</button>
            </form>
        </div>
    </main>
    <%- include('partials/footer') %>