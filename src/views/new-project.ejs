<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <!-- Uses existing form-card CSS class for styled white card with blue top border -->
        <div class="form-card">
            <form action="/new-project" method="POST">

                <!-- form-group class handles label + input layout and spacing -->
                <div class="form-group">
                    <label for="title">Title</label>
                    <input type="text" id="title" name="title" required maxlength="200" minlength="3"
                        placeholder="Enter project title">
                </div>

                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" required maxlength="1000"
                        placeholder="Describe the project"></textarea>
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input type="text" id="location" name="location" required maxlength="200"
                        placeholder="Enter project location">
                </div>

                <div class="form-group">
                    <label for="date">Date</label>
                    <input type="date" id="date" name="date" required>
                </div>

                <!-- NEW - organization dropdown, loops through organizations passed from controller -->
                <div class="form-group">
                    <label for="organizationId">Organization</label>
                    <select id="organizationId" name="organizationId" required>
                        <option value="">-- Select an Organization --</option>
                        <% organizations.forEach(org=> { %>
                            <option value="<%= org.organization_id %>">
                                <%= org.name %>
                            </option>
                            <% }) %>
                    </select>
                </div>

                <!-- form-submit-btn class gives the blue styled button -->
                <button type="submit" class="form-submit-btn">Add Project</button>
            </form>
        </div>
        
    </main>
    <%- include('partials/footer') %>