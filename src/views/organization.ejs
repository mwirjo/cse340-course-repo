<%- include('partials/header') %>
    <main>
        <h1>
            <%= organizationDetails.name %>
        </h1>

        <div class="org-detail-header">
            <div class="org-detail-logo-wrapper">
                <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">
            </div>
            <div class="org-detail-info">
                <h2>
                    <%= organizationDetails.name %>
                </h2>
                <p>
                    <%= organizationDetails.description %>
                </p>
                <p><strong>Contact:</strong>
                    <%= organizationDetails.contact_email %>
                </p>
            </div>
        </div>

        <% if (user && user.role_name==='admin' ) { %>
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="org-add-link">Edit
                Organization</a>
            <form action="/delete-organization/<%= organizationDetails.organization_id %>" method="POST"
                style="display:inline;">
                <button type="submit" class="btn-delete">Delete Organization</button>
            </form>
            <% } %>

                <h3>Service Projects</h3>
                <ul class="org-projects-list">
                    <% projects.forEach(project=> { %>
                        <li>
                            <a href="/project/<%= project.project_id %>">
                                <%= project.title %>
                            </a>
                        </li>
                        <% }) %>
                </ul>
    </main>
    <%- include('partials/footer') %>