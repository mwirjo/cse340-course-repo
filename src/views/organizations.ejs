<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <p>Here are a few of our partner organizations:</p>
        <% if (user && user.role_name==='admin' ) { %>
            <a href="/new-organization" class="org-add-link">+ Add New Organization</a>
            <% } %>

        <ul class="organizations-container">
            <% organizations.forEach(organization=> { %>
                <li class="org-card">
                    <div class="org-card-logo-wrapper">
                        <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    </div>
                    <div class="org-card-body">
                        <a class="org-card-name" href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                        <span class="org-card-email">
                            <%= organization.contact_email %>
                        </span>
                    </div>
                </li>
                <% }); %>
        </ul>

        
    </main>
    <%- include('partials/footer') %>