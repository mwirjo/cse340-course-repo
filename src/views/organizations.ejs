<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>
        <ul>

            <% organizations.forEach(organization=> { %>
                <li>
                    <img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <!-- Link to the organization details page using the organization_id in the URL -->
                    <!-- This generates URLs like /organization/13 where 13 is the organization ID -->
                    <strong>
                        <a href="/organization/<%= organization.organization_id %>">
                            <%= organization.name %>
                        </a>
                    </strong>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include('partials/footer') %>