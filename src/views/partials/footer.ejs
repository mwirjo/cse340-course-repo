<!-- 
  footer.ejs - This is an EJS PARTIAL
  A partial is a reusable template file included in other pages
  This footer appears on: home.ejs, organizations.ejs, projects.ejs, and categories.ejs
  
  This closes the HTML structure that was opened in header.ejs
  The closing </body> and </html> tags are here
-->

<!-- 
  FOOTER SECTION
  Displays copyright information at the bottom of every page
-->
<footer>
  <p>&copy; <%= new Date().getFullYear() %> CSE 340 Service Network.
      <% if (NODE_ENV==='development' ) { %>
        (Development mode)
        <% } %>
  </p>
</footer>

<!-- Dark mode toggle button - fixed position bottom right -->
<button class="dark-mode-toggle" id="darkModeToggle">🌙 Dark Mode</button>

<script>
  // Check for saved preference or system preference on page load
  const toggle = document.getElementById('darkModeToggle');
  const savedMode = localStorage.getItem('darkMode');
  const systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

  // Apply dark mode on load if saved or system default
  if (savedMode === 'enabled' || (!savedMode && systemDark)) {
    document.body.classList.add('dark-mode');
    toggle.textContent = '☀️ Light Mode';
  }

  // Toggle dark mode when button is clicked
  // Saves preference to localStorage so it persists across pages
  toggle.addEventListener('click', () => {
    document.body.classList.toggle('dark-mode');

    if (document.body.classList.contains('dark-mode')) {
      localStorage.setItem('darkMode', 'enabled');
      toggle.textContent = '☀️ Light Mode';
    } else {
      localStorage.setItem('darkMode', 'disabled');
      toggle.textContent = '🌙 Dark Mode';
    }
  });
</script>

<!-- Close the HTML document opened in header.ejs -->
</body>

</html>