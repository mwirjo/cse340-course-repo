<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= title %>
  </title>
  <link rel="stylesheet" href="/css/main.css">
  <!-- Prevent flash of dark mode - runs before page renders -->
  <script>
    if (localStorage.getItem('darkMode') === 'enabled') {
      document.documentElement.classList.add('dark-mode-early');
    }
  </script>
</head>

<body>
  <header>
    <nav>
      <!-- Site brand/logo -->
      <div class="nav-brand">
        <a href="/">CSE 340</a>
      </div>

      <!-- Hamburger button (mobile only) -->
      <button class="nav-hamburger" id="navHamburger" aria-label="Toggle navigation">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <!-- Nav links + settings -->
      <div class="nav-menu" id="navMenu">
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/organizations">Organizations</a></li>
          <li><a href="/projects">Projects</a></li>
          <li><a href="/categories">Categories</a></li>
          <% if (isLoggedIn) { %>
            <li><a href="/logout">Logout</a></li>
            <% } else { %>
              <li><a href="/register">Register</a></li>
              <li><a href="/login">Login</a></li>
              <% } %>
        </ul>
        <!-- Settings section inside nav -->
        <div class="nav-settings">
          <button class="dark-mode-toggle" id="darkModeToggle">🌙 Dark</button>
        </div>
      </div>
    </nav>
  </header>

  <!-- Flash messages -->
  <% const messages=flash(); %>
    <% Object.keys(messages).forEach(type=> { %>
      <% if (messages[type].length> 0) { %>
        <div class="alert <%= type %>">
          <% messages[type].forEach(msg=> { %>
            <p>
              <%= msg %>
            </p>
            <% }); %>
        </div>
        <% } %>
          <% }); %>