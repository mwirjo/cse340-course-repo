<%- include('partials/header') %>
    <main>
        <h2>
            <%= project.title %>
        </h2>

        <p>
            <%= project.description %>
        </p>

        <p><strong>Date:</strong>
            <%= project.date %>
        </p>

        <p><strong>Location:</strong>
            <%= project.location %>
        </p>

        <p><strong>Organization:</strong>
            <a href="/organization/<%= project.organization_id %>">
                <%= project.organization_name %>
            </a>
        </p>

        <div class="category-tags">
            <strong>Categories:</strong>
            <% categories.forEach(category=> { %>
                <a href="/category/<%= category.category_id %>" class="category-tag">
                    <%= category.name %>
                </a>
                <% }) %>
        </div>

        <% if (isLoggedIn) { %>
            <div class="volunteer-section">
                <% if (isVolunteered) { %>
                    <p class="volunteer-status">✅ You are volunteering for this project!</p>
                    <form action="/project/<%= project.project_id %>/unvolunteer" method="POST">
                        <button type="submit" class="btn-delete">🚫 Remove me</button>
                    </form>
                    <% } else { %>
                        <form action="/project/<%= project.project_id %>/volunteer" method="POST">
                            <button type="submit" class="btn-volunteer">🙋 Volunteer for this project</button>
                        </form>
                        <% } %>
            </div>
            <% } %>

                <% if (user && user.role_name==='admin' ) { %>
                    <a href="/project/<%= project.project_id %>/assign-categories" class="org-add-link">Edit
                        Categories</a>
                    <a href="/edit-project/<%= project.project_id %>" class="org-add-link">Edit Project</a>
                    <% } %>
    </main>
    <%- include('partials/footer') %>