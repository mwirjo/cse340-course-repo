<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <!-- NEW - link to the new project form -->
        <!-- NEW - styled link button matching organization page style -->
        
        <p>Here are the next five upcoming service projects:</p>
            <p>Here are the next five upcoming service projects:</p>
            <% if (user && user.role_name==='admin' ) { %>
                <a href="/new-project" class="org-add-link">+ Add New Project</a>
                <% } %>
        <!-- Projects container uses CSS grid/flex layout from stylesheet -->
        <div class="projects-container">
            <% projects.forEach(project=> { %>
                <!-- Each project card uses organization ID for color coding -->
                <div class="project-card project-org-<%= project.organization_id %>">

                    <!-- Project title links to the project details page -->
                    <p class="project-title">
                        <a href="/project/<%= project.project_id %>">
                            <%= project.title %>
                        </a>
                    </p>

                    <!-- Organization name links to the organization details page -->
                    <p class="project-org">
                        <a href="/organization/<%= project.organization_id %>">
                            <%= project.organization_name %>
                        </a>
                    </p>

                    <!-- Project description -->
                    <p class="project-description">
                        <%= project.description %>
                    </p>

                    <!-- Project location -->
                    <p class="project-location">📍 <%= project.location %>
                    </p>

                    <!-- Project date -->
                    <p class="project-date">📅 <%= project.date %>
                    </p>

                </div>
                <% }) %>
        </div>


    </main>
    <%- include('partials/footer') %>